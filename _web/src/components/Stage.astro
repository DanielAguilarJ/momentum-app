---
// Hero + scroll story. With JS the section is tall and its inner frame sticks; the scroll
// position picks the beat (0 hero, 1 detect, 2 block, 3 inbox). Without JS it reads top to bottom.
import Icon from "./Icon.astro";
import Phone from "./Phone.astro";
import { playUrl, type Copy } from "../copy";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<section class="stage" data-stage data-beat="0" aria-labelledby="hero-title">
  <div class="stage-frame">
    <canvas class="river" data-river aria-hidden="true"></canvas>
    <div class="river-fallback" aria-hidden="true"></div>
    <div class="shell stage-grid">
      <div class="stage-copy">
        <div class="hero-copy">
          <h1 id="hero-title"><span>{t.hero.h1a}</span> <span class="h1-b">{t.hero.h1b}</span></h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="actions">
            <a class="btn" href={playUrl(t.lang, "home-hero")} rel="noopener">
              <Icon name="download" />{t.hero.cta}
            </a>
            <a class="link-arrow" href="#como-funciona">{t.hero.how}<Icon name="arrow-down" /></a>
          </div>
          <p class="hero-meta">{t.hero.meta}</p>
        </div>

        <div class="story" id="como-funciona">
          <h2 class="visually-hidden">{t.story.label}</h2>
          <ol class="beats">
            {t.story.beats.map(([title, text], i) => (
              <li class="beat" data-index={i + 1}>
                <h3>{title}</h3>
                <p>{text}</p>
              </li>
            ))}
          </ol>
          <div class="rail" aria-hidden="true"><i data-index="1"></i><i data-index="2"></i><i data-index="3"></i></div>
        </div>
      </div>
      <div class="stage-device">
        <Phone t={t} />
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    position: relative;
    background: var(--night);
  }
  .stage-frame {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    align-items: center;
    padding-block: 120px 72px;
  }
  .river,
  .river-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .river {
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .river.ready {
    opacity: 1;
  }
  /* The still image of the scene before (or without) WebGL: the phone's own glow. */
  .river-fallback {
    background:
      radial-gradient(40% 50% at 70% 50%, rgb(99 102 241 / 0.22), transparent 70%),
      radial-gradient(30% 40% at 78% 70%, rgb(251 113 133 / 0.1), transparent 70%);
  }
  /* Legibility: the cards never run behind the copy at full strength. */
  .stage-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(7 6 15 / 0.94) 0%, rgb(7 6 15 / 0.82) 34%, rgb(7 6 15 / 0) 58%);
  }
  .stage-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .stage-copy {
    display: grid;
  }
  .hero-copy,
  .story {
    grid-area: 1 / 1;
  }
  h1 {
    font-size: clamp(3.1rem, 6.6vw, 5.25rem);
    line-height: 0.9;
    font-weight: 750;
    letter-spacing: -0.04em;
    font-stretch: 80%;
  }
  h1 span {
    display: block;
  }
  .h1-b {
    color: var(--violet-3);
  }
  .hero-copy .lead {
    margin-top: 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 36px;
  }
  .hero-meta {
    margin-top: 28px;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .story {
    display: none;
  }
  .beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .beat h3 {
    font-size: clamp(2.2rem, 4.6vw, 3.9rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .beat p {
    margin-top: 20px;
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    color: var(--ink-2);
    max-width: 27em;
  }
  .stage-device {
    display: grid;
    justify-items: center;
  }

  /* Scroll story (JS only). */
  :global(html.js) .stage {
    height: 380vh;
  }
  :global(html.js) .stage-frame {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-block: 88px 40px;
  }
  :global(html.js) .story {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 28px;
    align-items: center;
  }
  :global(html.js) .beats {
    grid-column: 2;
    grid-row: 1;
  }
  :global(html.js) .beat {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out), filter 0.7s var(--ease-out);
    pointer-events: none;
  }
  .rail {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 8px;
  }
  .rail i {
    width: 3px;
    height: 56px;
    border-radius: 3px;
    background: var(--line-2);
    transition: background-color 0.5s;
  }
  .hero-copy {
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out), filter 0.7s var(--ease-out);
  }
  .stage:not([data-beat="0"]) .hero-copy {
    opacity: 0;
    transform: translateY(-32px);
    filter: blur(8px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out), transform 0.9s var(--ease-out), filter 0.6s, visibility 0s 0.7s;
  }
  .stage[data-beat="0"] .story {
    visibility: hidden;
  }
  .stage[data-beat="1"] .beat[data-index="1"],
  .stage[data-beat="2"] .beat[data-index="2"],
  .stage[data-beat="3"] .beat[data-index="3"] {
    opacity: 1;
    transform: none;
    filter: none;
    transition-delay: 0.12s;
  }
  .stage[data-beat="1"] .rail i[data-index="1"],
  .stage[data-beat="2"] .rail i[data-index="2"],
  .stage[data-beat="3"] .rail i[data-index="3"] {
    background: var(--violet-3);
  }

  @media (max-width: 860px) {
    .stage-frame {
      padding-block: 104px 48px;
    }
    .stage-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    :global(html.js) .stage-frame {
      padding-block: 84px 24px;
      align-items: start;
    }
    :global(html.js) .stage-grid {
      height: 100%;
      grid-template-rows: auto 1fr;
      gap: 0;
    }
    :global(html.js) .stage-device {
      align-self: start;
      transform: translateY(var(--device-y, 0));
      transition: transform 1s var(--ease-out);
    }
    :global(html.js) .stage[data-beat="0"] .stage-device {
      --device-y: 28px;
    }
    :global(html.js) .stage:not([data-beat="0"]) .stage-device {
      --device-y: calc(-1 * var(--hero-h, 0px) + var(--story-h, 0px) + 24px);
    }
    .stage-frame::after {
      background: linear-gradient(180deg, rgb(7 6 15 / 0.9) 0%, rgb(7 6 15 / 0.78) 48%, rgb(7 6 15 / 0) 72%);
    }
    :global(html.js) .story {
      align-self: start;
    }
    .beat h3 {
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }
    .beat p {
      margin-top: 12px;
      font-size: 1rem;
    }
    .rail i {
      height: 34px;
    }
    .actions {
      gap: 8px 22px;
      margin-top: 28px;
    }
    .hero-copy .lead {
      margin-top: 20px;
    }
    .hero-meta {
      margin-top: 18px;
    }
  }
  @media (max-width: 860px) and (max-height: 760px) {
    .hero-meta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .river-fallback {
      opacity: 1;
    }
  }
</style>
