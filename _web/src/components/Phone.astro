---
// Simulated phone. Three screens driven by data-state on .phone:
// feed (endless reels) → detect (brackets lock on) → block (Momentum screen) → inbox (messages still work).
import Icon from "./Icon.astro";
import type { Copy } from "../copy";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const p = t.phone;
const reels = [0, 1, 2, 3, 0];
---

<figure class="device" data-device>
  <div class="phone" data-state="feed" data-phone>
    <div class="glass">
      <div class="status num" aria-hidden="true">
        <span>1:07</span>
        <span class="status-icons"><Icon name="signal" /><Icon name="wifi" /><Icon name="battery-full" /></span>
      </div>

      <div class="screen screen-feed" aria-hidden="true">
        <div class="reel-track">
          {reels.map((n) => (
            <div class={`reel reel-${n}`}>
              <div class="reel-video"><i></i><i></i><i></i></div>
              <div class="reel-rail">
                <Icon name="heart" /><Icon name="message-circle" /><Icon name="send" /><Icon name="ellipsis-vertical" />
              </div>
              <div class="reel-caption">
                <span class="avatar"></span>
                <span class="bars"><b></b><b></b></span>
                <span class="audio"><Icon name="music-2" />{p.caption}</span>
              </div>
              <div class="reel-progress"><span></span></div>
            </div>
          ))}
        </div>
        <div class="feed-tabs"><span class="on">{p.tabs[0]}</span><span>{p.tabs[1]}</span></div>
      </div>

      <div class="brackets" aria-hidden="true">
        <i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>
        <span class="tag num">{p.detected}</span>
      </div>

      <div class="screen screen-block" aria-hidden="true">
        <div class="block-mark"><Icon name="lock-keyhole" /></div>
        <p class="block-title">{p.blockTitle}</p>
        <p class="block-text">{p.blockText}</p>
        <span class="block-btn">{p.blockButton}</span>
        <span class="block-brand">Momentum</span>
      </div>

      <div class="screen screen-inbox" aria-hidden="true">
        <div class="inbox-head"><Icon name="arrow-left" /><span>{p.inbox}</span><Icon name="camera" /></div>
        <ul>
          {p.chats.map(([name, msg], i) => (
            <li>
              <span class={`ava ava-${i}`}>{name.slice(0, 1)}</span>
              <span class="chat"><b>{name}</b><span>{msg}</span></span>
              <span class="dot" />
            </li>
          ))}
        </ul>
      </div>

      <nav class="appbar" aria-hidden="true">
        <Icon name="house" /><Icon name="search" /><span class="reels-tab"><Icon name="clapperboard" /></span><span class="msg-tab"><Icon name="message-circle" /></span><Icon name="user" />
      </nav>
    </div>
  </div>
  <figcaption>{p.simulated}</figcaption>
</figure>

<style>
  .device {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 14px;
    perspective: 1600px;
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .phone {
    --w: clamp(232px, 22vw, 300px);
    width: var(--w);
    aspect-ratio: 300 / 624;
    border-radius: calc(var(--w) * 0.16);
    padding: calc(var(--w) * 0.032);
    background: linear-gradient(150deg, #2a2640 0%, #121020 38%, #0b0a14 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 1px 1px rgb(255 255 255 / 0.18),
      0 50px 90px -30px rgb(0 0 0 / 0.85),
      0 30px 60px -40px rgb(139 92 246 / 0.6);
    transform: rotateY(var(--ry, -16deg)) rotateX(var(--rx, 5deg)) rotateZ(var(--rz, 1.5deg));
    transform-style: preserve-3d;
    transition: transform 1.2s var(--ease-out);
    will-change: transform;
  }
  .glass {
    position: relative;
    height: 100%;
    border-radius: calc(var(--w) * 0.13);
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }
  .status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9% 9% 0;
    padding-top: calc(var(--w) * 0.045);
    font-size: calc(var(--w) * 0.042);
    color: #fff;
    font-weight: 600;
  }
  .status-icons {
    display: flex;
    gap: 4px;
  }
  .status :global(svg) {
    width: calc(var(--w) * 0.05);
    height: calc(var(--w) * 0.05);
  }
  .screen {
    position: absolute;
    inset: 0;
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out), filter 0.7s;
  }

  /* Feed: four reels that swipe up forever. */
  .screen-feed {
    overflow: hidden;
  }
  .reel-track {
    position: absolute;
    inset: 0;
    animation: swipe 11s var(--ease-in-out) infinite;
  }
  @keyframes swipe {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-100%); }
    50%, 70% { transform: translateY(-200%); }
    75%, 95% { transform: translateY(-300%); }
    100% { transform: translateY(-400%); }
  }
  .reel {
    position: absolute;
    left: 0;
    right: 0;
    height: 100%;
  }
  .reel-0 { top: 0; --a: #fb7185; --b: #f59e0b; --c: #3b1e7e; }
  .reel-1 { top: 100%; --a: #38bdf8; --b: #6366f1; --c: #0f172a; }
  .reel-2 { top: 200%; --a: #34d399; --b: #0ea5e9; --c: #052e2b; }
  .reel-3 { top: 300%; --a: #a78bfa; --b: #fb7185; --c: #1e1b4b; }
  .reel:nth-child(5) { top: 400%; }
  .reel-video {
    position: absolute;
    inset: 0;
    background: var(--c);
    overflow: hidden;
  }
  .reel-video i {
    position: absolute;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(28px);
    opacity: 0.85;
    animation: drift 7s ease-in-out infinite alternate;
  }
  .reel-video i:nth-child(1) { background: var(--a); left: -20%; top: 12%; }
  .reel-video i:nth-child(2) { background: var(--b); right: -30%; top: 42%; animation-delay: -2s; }
  .reel-video i:nth-child(3) { background: var(--a); left: 10%; bottom: -30%; width: 70%; opacity: 0.55; animation-delay: -4s; }
  @keyframes drift {
    to { transform: translate(12%, -10%) scale(1.15); }
  }
  .reel-video::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.35) 0%, transparent 22%, transparent 60%, rgb(0 0 0 / 0.6) 100%);
  }
  .reel-rail {
    position: absolute;
    right: 5%;
    bottom: 24%;
    display: grid;
    gap: calc(var(--w) * 0.06);
    color: #fff;
  }
  .reel-rail :global(svg) {
    width: calc(var(--w) * 0.08);
    height: calc(var(--w) * 0.08);
  }
  .reel-caption {
    position: absolute;
    left: 6%;
    right: 22%;
    bottom: 15%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 8px;
    align-items: center;
    color: rgb(255 255 255 / 0.9);
    font-size: calc(var(--w) * 0.036);
  }
  .avatar {
    width: calc(var(--w) * 0.09);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
  }
  .bars {
    display: grid;
    gap: 5px;
  }
  .bars b {
    height: 5px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.8);
    width: 70%;
  }
  .bars b + b {
    width: 45%;
    opacity: 0.6;
  }
  .audio {
    grid-column: 1 / -1;
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .audio :global(svg) {
    width: 12px;
    height: 12px;
  }
  .reel-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 11.5%;
    height: 2px;
    background: rgb(255 255 255 / 0.25);
  }
  .reel-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
    animation: progress 2.75s linear infinite;
  }
  @keyframes progress {
    to { width: 100%; }
  }
  .feed-tabs {
    position: absolute;
    top: calc(var(--w) * 0.14);
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: calc(var(--w) * 0.045);
    font-weight: 600;
    color: rgb(255 255 255 / 0.6);
  }
  .feed-tabs .on {
    color: #fff;
  }
  .appbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    height: 11.5%;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-bottom: 2%;
    background: #000;
    color: #fff;
  }
  .appbar :global(svg) {
    width: calc(var(--w) * 0.075);
    height: calc(var(--w) * 0.075);
  }
  .reels-tab {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* Detection brackets (viewfinder raise): snap onto the reels area. */
  .brackets {
    position: absolute;
    inset: 16% 6% 15% 6%;
    z-index: 7;
    pointer-events: none;
    opacity: 0;
    transform: scale(1.18);
    transition: opacity 0.4s, transform 0.8s var(--ease-out);
  }
  .brackets i {
    position: absolute;
    width: 22%;
    aspect-ratio: 1;
    border: 2.5px solid var(--violet-3);
  }
  .brackets .tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 14px; }
  .brackets .tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 14px; }
  .brackets .bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 14px; }
  .brackets .br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 14px; }
  .tag {
    position: absolute;
    left: 50%;
    top: 14px;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--violet-3);
    color: #1b1340;
    font-size: calc(var(--w) * 0.036);
    font-weight: 600;
  }
  .phone[data-state="detect"] .brackets {
    opacity: 1;
    transform: scale(1);
  }
  .phone[data-state="detect"] .screen-feed {
    filter: saturate(0.6) brightness(0.8);
  }

  /* Momentum block screen. */
  .screen-block {
    z-index: 4;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    gap: calc(var(--w) * 0.035);
    padding: 0 12%;
    background: radial-gradient(120% 70% at 50% 35%, #2a1d66 0%, #110d26 60%, #07060f 100%);
    opacity: 0;
    transform: translateY(8%);
  }
  .block-mark {
    width: calc(var(--w) * 0.2);
    aspect-ratio: 1;
    border-radius: 28%;
    display: grid;
    place-items: center;
    background: var(--violet);
    color: #fff;
    box-shadow: 0 14px 30px -10px rgb(139 92 246 / 0.8);
    margin-bottom: calc(var(--w) * 0.03);
  }
  .block-mark :global(svg) {
    width: 46%;
    height: 46%;
  }
  .block-title {
    font-family: var(--font-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: calc(var(--w) * 0.085);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
  }
  .block-text {
    font-size: calc(var(--w) * 0.044);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .block-btn {
    margin-top: calc(var(--w) * 0.05);
    padding: calc(var(--w) * 0.03) calc(var(--w) * 0.07);
    border-radius: 999px;
    background: #fff;
    color: #120e26;
    font-size: calc(var(--w) * 0.042);
    font-weight: 600;
  }
  .block-brand {
    position: absolute;
    bottom: 16%;
    font-size: calc(var(--w) * 0.038);
    color: var(--ink-3);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .phone[data-state="block"] .screen-block {
    opacity: 1;
    transform: none;
  }

  /* Messages still work. */
  .screen-inbox {
    z-index: 4;
    background: #0b0a12;
    padding: calc(var(--w) * 0.16) 7% 0;
    opacity: 0;
    transform: translateX(10%);
    color: #fff;
  }
  .inbox-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    font-size: calc(var(--w) * 0.058);
    margin-bottom: calc(var(--w) * 0.05);
  }
  .inbox-head :global(svg) {
    width: calc(var(--w) * 0.065);
    height: calc(var(--w) * 0.065);
  }
  .screen-inbox ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--w) * 0.05);
  }
  .screen-inbox li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: center;
  }
  .ava {
    width: calc(var(--w) * 0.13);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: calc(var(--w) * 0.05);
    color: #0b0a12;
  }
  .ava-0 { background: var(--amber); }
  .ava-1 { background: var(--sky); }
  .ava-2 { background: var(--rose); }
  .ava-3 { background: var(--mint); }
  .chat {
    display: grid;
    min-width: 0;
    font-size: calc(var(--w) * 0.042);
    line-height: 1.3;
  }
  .chat span {
    color: rgb(255 255 255 / 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--violet-2);
  }
  .phone[data-state="inbox"] .screen-inbox {
    opacity: 1;
    transform: none;
  }
  .phone[data-state="inbox"] .screen-feed {
    opacity: 0;
  }
  .msg-tab,
  .reels-tab {
    display: grid;
    place-items: center;
    transition: color 0.5s;
  }
  .phone[data-state="inbox"] .msg-tab {
    color: var(--violet-3);
  }
  .phone[data-state="block"] .reels-tab,
  .phone[data-state="inbox"] .reels-tab {
    color: rgb(255 255 255 / 0.35);
  }
</style>
